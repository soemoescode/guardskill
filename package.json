{
  "name": "guardskill",
  "version": "0.5.2",
  "description": "Read-only scanner for what makes a coding agent (Claude Code, Codex, Cursor, Copilot, Goose) execute code when it opens a project: git settings — fsmonitor, filters, hooks, aliases, includes, bare repositories in the tree — and committed agent settings and MCP server definitions. SARIF output. No dependencies, no network.",
  "type": "module",
  "bin": {
    "guardskill": "bin/guardskill.js"
  },
  "main": "./src/scanners/gitconfig.js",
  "exports": {
    ".": "./src/scanners/gitconfig.js",
    "./rules": "./rules/git-exec-keys.json"
  },
  "scripts": {
    "pretest": "node test/fixtures/generate.js",
    "test": "node test/run.js",
    "scan": "node bin/guardskill.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Helios IT Solutions B.V. (https://helios-it.nl)",
  "homepage": "https://github.com/soemoescode/guardskill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soemoescode/guardskill.git"
  },
  "bugs": {
    "url": "https://github.com/soemoescode/guardskill/issues"
  },
  "keywords": [
    "security",
    "coding-agent",
    "ai-agent",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "git",
    "gitspawn",
    "supply-chain",
    "static-analysis",
    "cli",
    "mcp",
    "sarif",
    "agent-security",
    "code-scanning",
    "devsecops"
  ],
  "files": [
    "bin",
    "src",
    "rules",
    "SKILL.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
